# Supabase (from `supabase start` output, or your hosted project settings)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# API-NFL (behind the SportsDataProvider abstraction). Association
# football (API-Football) was supported at launch and has since been
# retired — see docs/ARCHITECTURE.md.
API_NFL_BASE_URL=https://v1.american-football.api-sports.io
API_NFL_KEY=
API_NFL_ENABLED=false
# NBA / NHL use the same API-Sports account key (API_NFL_KEY is used as the fallback key; set API_SPORTS_KEY to name it explicitly, or
# API_NBA_KEY / API_NHL_KEY for a sport-specific key). Each sport is active only when its own flag is "true" AND its API-Sports plan can read
# the current season (the Free plan cannot) — see docs/SPORTS_AUDIT_NHL_NBA.md.
API_NBA_ENABLED=false
API_NHL_ENABLED=false
# Optional per-sport self-imposed daily request ceilings (background jobs stop before the plan's real limit): API_NFL_DAILY_REQUEST_BUDGET, API_NBA_DAILY_REQUEST_BUDGET, API_NHL_DAILY_REQUEST_BUDGET

DEFAULT_TIMEZONE=America/Costa_Rica

# App
APP_URL=http://localhost:3000
CRON_SECRET=

# Optional in V1
RESEND_API_KEY=

# Error monitoring (Sentry) — optional; the SDK no-ops with no DSN set.
# See docs/DEPLOYMENT.md for setup. SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN
# are build-time-only and just enable source-map upload — not required to
# receive errors.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Sponsorship payments — provider secrets (sponsor -> Brohda, for advertising only; NOT the player money provider). Server-side only; never commit real values.
# WHICH provider is used (and on/off) is NOT set here: it is the Super Admin's "Online sponsorship payments" setting. These are the ONVO adapter's secrets/runtime config.
# All four are required for ONVO to be available; anything missing or inconsistent makes it "unavailable" (fail closed). See docs/architecture/commercial-payments.md.
ONVO_SECRET_KEY=
ONVO_WEBHOOK_SECRET=
ONVO_ENVIRONMENT=TEST
# Live payments additionally require ONVO_LIVE_ENABLED=true (and a live key). Leave unset until the owner authorizes the live cutover.
# ONVO_LIVE_ENABLED=
# TEST checkout is hidden from Sponsors on the production deployment unless this is "true".
# PAYMENTS_ALLOW_TEST_IN_PRODUCTION=
# Optional API origin override (defaults to the documented production API host).
# ONVO_API_BASE=
